# FitData Hub — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=fitdata
DB_USER=fitdata
DB_PASSWORD=fitdata_secret_change_me

# ---------------------------------------------------------------------------
# Internal use — consumed by docker-compose for the postgres service
# ---------------------------------------------------------------------------
POSTGRES_DB=fitdata
POSTGRES_USER=fitdata
POSTGRES_PASSWORD=fitdata_secret_change_me
